        return self.weight

    def id_container(self):
        return self.id

    def fuel_consumption(self):
        return 0

    def container_type(self):
        return "general"

    def check_equal(self, other):
        if type(self.id) == type(other.id) and type(self.weight) == type(other.weight):
            return "True"
        else:
            return "false"

    def container_list(self):
        self.station_instance.containers['general'].append(self)




class NormalContainer(container):
    def __init__(self, container_id, weight, station_instance):
        super().__init__(container_id, weight, station_instance)

    def container_type(self):
        if self.weight <= 3000:
            return "Normal container"

    def fuel_consumption(self):
        if self.weight <= 3000:
            return self.weight * 2.50

    def check_type(self, other):
        if type(self.id) == type(other.id) and type(self.weight) == type(other.weight):
            return "True"
        else:
            return "false"

    def container_list(self):
        self.station_instance.containers['NormalContainer'].append(self)

    def __str__(self):
        return f"NormalContainer(ID: {self.id}, weight: {self.weight})"

class HeavyContainer(container):
    def __init__(self, container_id, weight, station_instance):
        super().__init__(container_id, weight, station_instance)

    def fuel_consumption(self):
        if self.weight > 3000:
            return self.weight * 3.00

    def container_type(self):
        if self.weight > 3000:
            return "Heavy container"

    def check_type(self, other):
        if type(self.id) == type(other.id) and type(self.weight) == type(other.weight):
            return "True"
        else:
            return "false"

    def container_list(self):
        if isinstance(self, RefrigeratedContainer):
            self.station_instance.containers['RefrigeratedContainer'].append(self)
        elif isinstance(self, LiquidContainer):
            self.station_instance.containers['LiquidContainer'].append(self)
        else:
            self.station_instance.containers['HeavyContainer'].append(self)

    def __str__(self):
        return f"HeavyContainer(ID: {self.id}, weight: {self.weight})"


class RefrigeratedContainer(HeavyContainer):
    def __init__(self, id, weight, Heavy_type, station_instance):
        super().__init__(id, weight, station_instance)
        self.type = Heavy_type

    def Type_of_container(self):
        if self.type == "r" or "R":
            return "Refrigerated_container"

    def fuel_consumption(self):
        if self.type == "r" or "R":
            return self.weight * 5.00

    def container_list(self):
        if isinstance(self, RefrigeratedContainer):
            self.station_instance.containers['RefrigeratedContainer'].append(self)

    def __str__(self):
        return f"RefrigeratedContainer(ID: {self.id}, weight: {self.weight}, type: {self.type})"


class LiquidContainer(HeavyContainer):
    def __init__(self, id, weight, Heavy_type, station_instance):
        super().__init__(id, weight, station_instance)
        self.type = Heavy_type


    def Type_of_container(self):
        if self.type == "l" or "L":
            return "Liquid container"

    def fuel_consumption(self):
        if self.type == "l" or "L":
            return self.weight * 4.00

    def container_list(self):
        self.station_instance.containers['LiquidContainer'].append(self)

    def __str__(self):
        return f"LiquidContainer(ID: {self.id}, weight: {self.weight}, type: {self.type})"
class Station:
 station_id = 0
